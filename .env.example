# Copy to .env (never commit .env). All variables use the GRAPHRAG_ prefix.
# Every key below is a real setting (a test checks this file against the code).

# --- General ---------------------------------------------------------------------------------
GRAPHRAG_ENVIRONMENT=development
GRAPHRAG_LOG_LEVEL=INFO
# GRAPHRAG_DATA_DIR=./data
# GRAPHRAG_DATABASE_URL=sqlite:///./data/graphrag.db
GRAPHRAG_MAX_UPLOAD_MB=25
GRAPHRAG_CORS_ORIGINS=["http://localhost:5173"]
# Optional shared API key (leave unset for local single-user use)
# GRAPHRAG_API_KEY=

# --- Ingestion ---------------------------------------------------------------------------------
# Chunk size/overlap are in CHARACTERS (the embedding token limit is handled separately, below).
GRAPHRAG_CHUNK_SIZE=800
GRAPHRAG_CHUNK_OVERLAP=100
GRAPHRAG_WORKER_THREADS=2

# --- Knowledge extraction ------------------------------------------------------------------------
# rule_based = deterministic demo/test extractor (low recall); mock = extracts nothing.
# "llm" needs a client that arrives with Phase 7 and fails at start-up until then.
GRAPHRAG_EXTRACTION_PROVIDER=rule_based
GRAPHRAG_FUZZY_MATCH_THRESHOLD=0.88

# --- Knowledge graph limits (hard caps enforced on every request) --------------------------------
GRAPHRAG_GRAPH_MAX_HOPS=4
GRAPHRAG_GRAPH_MAX_NODES=500
GRAPHRAG_GRAPH_MAX_EDGES=1000

# --- Embeddings and vector search ----------------------------------------------------------------
# sentence_transformers = the real model. hashing = deterministic lexical STUB used by the tests;
# it is not semantic, never use it for real retrieval.
GRAPHRAG_EMBEDDING_PROVIDER=sentence_transformers
GRAPHRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Exact Hugging Face commit this project was verified with (384 dimensions, 256-token limit).
# It applies to the default model only. For another model set its own 40-character commit hash, or
# leave this empty to run unpinned (not advised: an upstream update could change your vectors).
# A different pin, model or max sequence length discards the vector index and rebuilds it.
GRAPHRAG_EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
GRAPHRAG_EMBEDDING_BATCH_SIZE=32
GRAPHRAG_EMBEDDING_DEVICE=cpu
# Optional lower token limit than the model's own (changes vectors, so it is part of the fingerprint).
# GRAPHRAG_EMBEDDING_MAX_SEQ_LENGTH=
# Where model files are cached. Keep this on a drive with space (the default is <data_dir>/models).
# GRAPHRAG_EMBEDDING_CACHE_DIR=
# true = use only the local cache, never the network. A missing cache or pinned revision then fails
# with an explicit error; no other model is ever substituted.
GRAPHRAG_EMBEDDING_OFFLINE=false
# Reconcile the vector index with the database at start-up (can take a while after a bulk import).
GRAPHRAG_VECTOR_SYNC_ON_STARTUP=true
GRAPHRAG_VECTOR_MAX_TOP_K=50

# --- Hybrid retrieval (vector + knowledge graph) -----------------------------------------------
# Reciprocal Rank Fusion constant: fused score = sum(weight / (k + rank)). 60 is the textbook
# starting point, not a tuned value. Requests may set their own k, weights and limits.
GRAPHRAG_HYBRID_RRF_K=60
# Upper bound for the number of fused results a request may ask for.
GRAPHRAG_HYBRID_MAX_LIMIT=50
# Upper bound for graph-path candidate chunks.
GRAPHRAG_HYBRID_GRAPH_MAX_CHUNKS=50
# Upper bound for graph hops in hybrid/graph search (never above GRAPHRAG_GRAPH_MAX_HOPS).
GRAPHRAG_HYBRID_GRAPH_MAX_HOPS=2
# Longest entity name (in words) that is looked for inside a query.
GRAPHRAG_HYBRID_MAX_NAME_TOKENS=8
# Time budget (seconds) for each path of a hybrid search; 0 = unlimited. A path that overruns it
# is reported unavailable (vector_timeout / graph_timeout) and the other path's result is returned.
# The first search after start-up may need ~15 s to load the embedding model on a slow machine.
GRAPHRAG_HYBRID_PATH_TIMEOUT_SECONDS=30

# --- Answer generation (Phase 7) -----------------------------------------------------------------
# extractive = no model, no network: the answer is composed from the best-ranked sentences of the
# retrieved text and says so. mock = scripted test provider (never use for real questions).
# ollama / openai_compatible talk to a LOCAL model server by default.
GRAPHRAG_LLM_PROVIDER=extractive
# Needed for ollama and openai_compatible. Ollama's default is http://127.0.0.1:11434.
# GRAPHRAG_LLM_BASE_URL=http://127.0.0.1:11434
# GRAPHRAG_LLM_MODEL=
# The NAME of an environment variable that holds an API key (never put the key here).
# GRAPHRAG_LLM_API_KEY_ENV=
# Retrieved document text is sent to the provider: a non-loopback host is refused unless allowed.
GRAPHRAG_LLM_ALLOW_REMOTE=false
GRAPHRAG_LLM_TIMEOUT_SECONDS=120
GRAPHRAG_LLM_RETRIES=1
# The model's context window and the room reserved for the answer. answer_context_tokens +
# max_answer_tokens + 400 tokens of prompt overhead must fit the window.
GRAPHRAG_LLM_CONTEXT_WINDOW=4096
GRAPHRAG_LLM_MAX_ANSWER_TOKENS=512
GRAPHRAG_ANSWER_CONTEXT_TOKENS=2048
# Token counts for the budget are ESTIMATES (characters / this number); lower = more cautious.
GRAPHRAG_ANSWER_CHARS_PER_TOKEN=3.0
# Concurrent generations (CPU generation is slow; extra requests wait briefly, then get 503).
GRAPHRAG_LLM_MAX_CONCURRENCY=1
# Answer with the extractive provider if the configured one fails (always labelled in the response).
GRAPHRAG_LLM_FALLBACK_TO_EXTRACTIVE=false
# Development only: allow a request to ask for the prompt back.
GRAPHRAG_LLM_DEBUG_PROMPT=false
# withhold = an answer whose citations cannot be verified is not returned; annotate = returned, marked.
GRAPHRAG_ANSWER_GROUNDING_POLICY=withhold
# Optional gate on the best retrieval similarity (model-specific and uncalibrated: off by default).
# GRAPHRAG_ANSWER_MIN_TOP_SIMILARITY=
# Relationship types known to have ONE target per source, for conflict detection (JSON list).
GRAPHRAG_ANSWER_FUNCTIONAL_RELATIONSHIPS=[]
# Keep a local history of questions and answers in the SQLite database (deletable via the API).
GRAPHRAG_QUERY_HISTORY=true
